# ============================================================
# LOJINHA BACKEND — Environment Variables
# Copia este ficheiro para .env e preenche os valores reais
# ============================================================

# Porta do servidor (padrão: 3001)
PORT=3001

# URL pública do backend (para configurar webhook na Evolution)
# Ex: https://meu-backend.railway.app
BACKEND_PUBLIC_URL=http://localhost:3001

# ---- EVOLUTION API SaaS ----
EVOLUTION_API_URL=https://api.evolution-api.com
EVOLUTION_API_KEY=SUA_API_KEY_AQUI

# ---- SUPABASE ----
SUPABASE_URL=https://nijlwzqxsgmutpstujoz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# Chave secreta para validar chamadas do frontend ao backend
# Gera com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=GERA_UM_SECRET_AQUI

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5173,https://lojinha.my,https://www.lojinha.my
